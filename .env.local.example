# Supabase — Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 서버 전용 (절대 클라이언트에 노출 금지). 관리자 스크립트/시드에만 사용
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 사이트 절대 URL (OAuth redirect, 메타데이터에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 카드 데이터 소스 (어댑터 선택) ──────────────────────────────
# opensource   = Riftcodex 공개 API (https://api.riftcodex.com/cards) + data/cards.json 스냅샷 폴백. 기본.
# official-riot = 라이엇 공식 Content API (Production 승인 후. 그 전엔 에러남)
NEXT_PUBLIC_DATA_SOURCE=opensource
# 카드 API 엔드포인트 override (미설정 시 Riftcodex `/cards`). 스냅샷 갱신: npm run sync:cards
# OPENSOURCE_CARDS_ENDPOINT=https://api.riftcodex.com/cards
# OPENSOURCE_CARDS_API_KEY=

# Riot API — developer.riotgames.com 에서 발급. 서버 전용, 절대 커밋/클라이언트 노출 금지.
# 개발용 키(RGAPI-...)는 24시간마다 만료된다. 프로덕션 키는 앱 승인 후 발급.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RIOT_CONTENT_LOCALE=en_US   # 공식 한글 데이터 열리면 ko_KR

# JustTCG — justtcg.com 가입 즉시 발급. 시세 동기화 스크립트에서만 사용.
# GitHub Actions 로도 돌리므로 repo Secrets 에도 등록: JUSTTCG_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
JUSTTCG_API_KEY=
# JUSTTCG_GAME=riftbound-league-of-legends   # 실제 게임 슬러그 확인 후 필요시 override
